# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Security
JWT_SECRET=super_secret_jwt_key_replace_in_production_min32chars!

# Database Configuration (Optional: If omitted or un-routable, falls back to secure local JSON storage)
MONGODB_URI=mongodb://127.0.0.1:27017/food_cost_optimizer

# AI Advisor Configuration (Optional: If omitted, system seamlessly runs in intelligent offline demo mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
